# Example environment configuration for Luneta
# Copy this file to .env and adjust values.

APP_ENV=development

WEB_URL=http://localhost:5173
APP_DISPLAY_NAME="XR for Youth Ethics Consortium"
API_URL=http://localhost:8000

# MongoDB (Atlas or local)
# Atlas: replace YOUR_PASSWORD (URL-encode special chars). Database name /luneta is required.
MONGODB_URI=mongodb+srv://danielbarberoj_db_user:YOUR_PASSWORD@lunetacluster.yirmn6h.mongodb.net/luneta?retryWrites=true&w=majority&appName=lunetaCluster

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_LUNETA=luneta-assets
# MinIO container login (Console/API root user)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Email — local dev: Mailhog (SMTP). Production on Render: Brevo HTTPS API (SMTP blocked on free tier).
EMAIL_FROM="XR for Youth Ethics Consortium <no-reply@luneta.local>"
# BREVO_API_KEY=           # production (Brevo → SMTP & API → Create API key)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
# Brevo SMTP (local testing only; use BREVO_API_KEY on Render):
# EMAIL_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=af568f001@smtp-brevo.com
# EMAIL_SMTP_PASSWORD=your-brevo-smtp-key
# Log SMTP errors but do not fail API requests (set false in production if you want hard failures)
EMAIL_FAIL_SILENTLY=true

# AI provider: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Chat suggestions always use gemini-2.5-flash-lite (see gemini_client.GEMINI_CHAT_MODEL_ID)
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
