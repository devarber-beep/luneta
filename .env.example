# Example environment configuration for Luneta
# Copy this file to .env and adjust values.

APP_ENV=development

WEB_URL=http://localhost:5173
API_URL=http://localhost:8000

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/luneta

# Redis (Taskiq broker + backend)
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_LUNETA=luneta-assets
# MinIO container login (Console/API root user)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Email (dev: Mailhog)
EMAIL_FROM="Luneta <no-reply@luneta.local>"
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
# Log SMTP errors but do not fail API requests (set false in production if you want hard failures)
EMAIL_FAIL_SILENTLY=true

# AI provider: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Chat suggestions always use gemini-2.5-flash-lite (see gemini_client.GEMINI_CHAT_MODEL_ID)
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
