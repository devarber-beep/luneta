# Production environment — copy values into Render / Cloudflare dashboards.
# Do NOT commit real secrets. Use each provider's secret/env UI.

# Public URLs (replace with your domain after DNS setup)
WEB_URL=https://luneta.org
# VITE_API_URL is set at Cloudflare Pages build time (not in the API):
# VITE_API_URL=https://api.luneta.org

# MongoDB Atlas (Network Access: allow 0.0.0.0/0 or Render egress IPs)
MONGODB_URI=mongodb+srv://danielbarberoj_db_user:YOUR_PASSWORD@lunetacluster.yirmn6h.mongodb.net/luneta?retryWrites=true&w=majority&appName=lunetaCluster

# Auth — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=

# Cloudflare R2 (S3-compatible). Create bucket "luneta-assets" in R2 dashboard.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_LUNETA=luneta-assets

# Email — Brevo (free tier) or Resend SMTP
EMAIL_FROM="Luneta <no-reply@xrforyouthethics.org>"
BREVO_API_KEY=your-brevo-api-key
EMAIL_FAIL_SILENTLY=false
# SMTP not used on Render free tier; optional for local Brevo SMTP tests:
# EMAIL_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=af568f001@smtp-brevo.com
# EMAIL_SMTP_PASSWORD=your-brevo-smtp-key

# AI (optional but needed for suggestions)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Never enable in production
DEV_EXPOSE_LAST_EMAIL_VERIFICATION_TOKEN=false
